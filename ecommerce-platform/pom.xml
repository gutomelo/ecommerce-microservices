<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.ecommerce</groupId>
    <artifactId>ecommerce-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>ecommerce-platform</name>
    <description>Plataforma de e-commerce baseada em microsservicos orientados a eventos (Saga por coreografia via AWS SNS/SQS)</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>

        <!-- Versoes de plugins Maven, centralizadas aqui pois o root pom nao usa spring-boot-starter-parent -->
        <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>3.5.6</maven-failsafe-plugin.version>
        <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>
        <lombok.version>1.18.46</lombok.version>
        <!-- Deve ficar igual a spring-boot.version em platform/platform-bom/pom.xml -->
        <spring-boot-maven-plugin.version>3.5.16</spring-boot-maven-plugin.version>

        <!-- Cobertura minima exigida por .claude/rules/testes.md -->
        <jacoco.line.coverage.minimum>0.80</jacoco.line.coverage.minimum>
    </properties>

    <!--
        Modulos sao adicionados incrementalmente conforme o plano de implementacao
        (ver /home/guto/.claude/plans/goofy-zooming-sketch.md): platform/ primeiro,
        depois cada services/<nome>-service a medida que for criado.
    -->
    <modules>
        <module>platform</module>
        <module>services</module>
    </modules>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <!--
                            Sem isto, @PathVariable/@RequestParam sem nome explicito
                            (ex.: @PathVariable UUID id) falham em runtime com
                            "Name for argument of type [...] not specified" - o
                            spring-boot-starter-parent configura isto por padrao, mas o
                            root pom nao o usa.
                        -->
                        <parameters>true</parameters>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                    <configuration>
                        <!--
                            Testes *IT.java (ex.: Testcontainers/LocalStack) rodam via Failsafe na
                            fase verify, nao aqui - mantem "mvn test" rapido e sem dependencia de Docker.
                        -->
                        <excludes>
                            <exclude>**/*IT.java</exclude>
                        </excludes>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven-failsafe-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot-maven-plugin.version}</version>
                    <executions>
                        <execution>
                            <!--
                                classifier=exec evita que o repackage SOBRESCREVA o jar simples
                                (target/<servico>.jar) pelo fat jar - descoberto na pratica: quando
                                o repackage substitui o jar padrao, o Failsafe (fase verify/
                                integration-test) falha ao resolver metadados de anotacao do Spring
                                TestContext (@BootstrapWith) para testes *IT.java, mesmo sem nenhuma
                                relacao aparente. Com o classifier, o executavel fica em
                                target/<servico>-exec.jar (usado no Dockerfile) e o jar simples
                                permanece intacto para os testes.
                            -->
                            <configuration>
                                <classifier>exec</classifier>
                            </configuration>
                            <goals>
                                <goal>repackage</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!--
                JaCoCo roda em todos os modulos filhos (herdado via build/plugins, nao pluginManagement).
                Gate de cobertura minima definido em .claude/rules/testes.md.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco-maven-plugin.version}</version>
                <configuration>
                    <!--
                        A classe *Application (main de cada microsservico) so contem a
                        chamada SpringApplication.run(...) - @SpringBootTest nao invoca o
                        metodo main() literalmente, entao essa linha nunca aparece coberta
                        mesmo com o contexto totalmente testado. Excluir daqui evita que
                        todo servico precise repetir essa exclusao no proprio pom.xml.
                    -->
                    <excludes>
                        <exclude>**/*Application.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <!--
                            Fase verify (nao test): roda depois do Failsafe, para que o
                            relatorio reflita tambem os testes *IT.java (Testcontainers/LocalStack),
                            nao so os testes unitarios.
                        -->
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.line.coverage.minimum}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
                Failsafe roda os testes *IT.java (integration-test/verify), com Docker
                (Testcontainers/LocalStack) quando aplicavel. "mvn install" ainda os executa
                (install roda depois de verify no ciclo de vida padrao).
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
